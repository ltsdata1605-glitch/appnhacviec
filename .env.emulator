# Chỉ dùng khi chạy kiểm thử tự động trên Firebase Emulator: npm run build -- --mode emulator
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-nhacviec
VITE_FIREBASE_STORAGE_BUCKET=demo-nhacviec.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=1:0:web:0
VITE_FIREBASE_VAPID_KEY=
VITE_USE_EMULATORS=1
