# Sao chép file này thành .env rồi điền thông tin từ Firebase Console
# (Project settings > General > Your apps > SDK setup and configuration > Config)
VITE_FIREBASE_API_KEY=
# Giữ nguyên dạng <project-id>.firebaseapp.com; mở app bằng chính địa chỉ này để đăng nhập Google ổn định trên iPhone
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Cloud Messaging > Web Push certificates > Key pair
VITE_FIREBASE_VAPID_KEY=
